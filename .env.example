# PostgreSQL Database Password & Connection URLs
DB_PASSWORD=changeme123
DATABASE_URL=postgresql+asyncpg://Infera:changeme123@localhost:5432/Infera
TEST_DATABASE_URL=postgresql+asyncpg://Infera:changeme123@localhost:5432/infera_test

# JWT Authentication
SECRET_KEY= # Generate using: openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Machine Learning & Retraining
MODEL_RETRAIN_INTERVAL_MINUTES=30
ANOMALY_CONTAMINATION_RATE=0.05

# Anomaly Thresholds
TOKEN_SPIKE_THRESHOLD=3.0
LATENCY_SPIKE_THRESHOLD=3.0
LOOP_COUNT_THRESHOLD=10
FAILURE_CASCADE_WINDOW=5

# Simulator Configuration
SIMULATOR_TICK_INTERVAL_SEC=2
COST_PER_1K_TOKENS=0.002

# Real LLM Agent Configuration
# Google AI Studio is the default provider. Use LLM_PROVIDER=groq to select Groq.
LLM_PROVIDER=google
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Groq fallback/alternative (Free Tier at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
